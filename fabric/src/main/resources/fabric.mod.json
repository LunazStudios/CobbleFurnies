{
  "schemaVersion": 1,
  "id": "cobblefurnies",
  "version": "${version}",
  "name": "CobbleFurnies",
  "description": "Whether you're building a professor's lab, a bustling Pokécenter, or just a cozy cabin in the woods, CobbleFurnies is here to make your world feel more alive!",
  "authors": [
    "LunazStudios"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/cobblefurnies",
    "issues": "https://github.com/gifluana/CobbleFurnies/issues"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.lunazstudios.cobblefurnies.fabric.CobbleFurniesFabric"
    ],
    "client": [
      "com.lunazstudios.cobblefurnies.fabric.client.CobbleFurniesFabricClient"
    ],
    "rei_client": [
      "com.lunazstudios.cobblefurnies.fabric.compat.CobbleFurniesREIClient"
    ],
    "jei_mod_plugin": [
      "com.lunazstudios.cobblefurnies.compat.JEICobbleFurniesPlugin"
    ]
  },
  "mixins": [
    "cobblefurnies.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "1.21.1",
    "java": ">=21",
    "athena": ">=4.0.6",
    "architectury": ">=13.0.11",
    "fabric-api": ">=0.116.18+1.21.1",
    "fabric-language-kotlin": ">=1.13.12+kotlin.2.4.0"
  },
  "suggests": {
    "cobblemon": ">=1.8.4 <1.9"
  },
  "breaks": {
    "cobblemon": ["<1.8.4", ">=1.9"]
  }
}
